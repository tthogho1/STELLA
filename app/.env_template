#
# Environment Variables for STELLA
#
# To get started, run setup.py and follow the instructions.
# For detailed information, visit https://docs.stellaframework.com/ and search for "Environment Variables"
#
# ================================
# STELLA Configuration
# ================================
HOST="0.0.0.0"                              # Host to run the server on
PORT="5001"                                 # Port to run the server on

BCRYPT_SALT=""                              # Generated by stella configure
JWT_SECRET_KEY=""                           # Generated by stella configure
JWT_ACCESS_TOKEN_EXPIRES="7"                # How long user access tokens will be valid (in days)

SOCK_SERVER_OPTIONS_PING_INTERVAL="150"     # time interval between each ping message (in seconds)
ASYNC_MODE="gevent"                         # gevent is recommended
FLASK_CONFIG="development"                  # development, production (development enables debug mode)

AGENT_MAX_DEPTH="5"                         # Max amount of calls for a single agent when solving a task
OVERALL_TASK_MAX_DEPTH="10"                 # Maximum depth (agent calls) a task can have before it is stopped
# Note: every agent call is at least one LLM request, and each request re-sends the whole
# chat history plus accumulated memories. Raise these only if you know what it will cost.

# Dependencies
OPENAI_API_KEY=""                           # OpenAI API key can be found on your OpenAI profile page
OPENAI_BASE_URL=""                          # Blank talks to OpenAI. Point it at any OpenAI-compatible
                                            # endpoint to use another provider or a local model --
                                            # "http://localhost:11434/v1" for Ollama, where the key is
                                            # required but ignored (use any non-empty string). Read by
                                            # the OpenAI SDK straight from the environment, so it does
                                            # not appear anywhere in this repository's code.
OPENAI_MODEL_ACTION_SELECTION="gpt-4o-mini" # Model used to pick the next agent
# Note: this model now has to read the results gathered so far and decide what is still
# missing, not just name a tool. If you see agents being called again for information
# they already returned, the results are probably too long or badly ordered for this
# model to follow; lowering MAX_MEMORY_ENTRY_CHARS or moving to "gpt-4o" both help.
OPENAI_MODEL_RESPONSE="gpt-4o"              # Model used to generate responses
OPENAI_MAX_RETRIES="4"                      # Retries for rate limits (429), 5xx and connection errors,
                                            # with exponential backoff. Errors retrying cannot fix (bad key,
                                            # prompt over the context window) still fail immediately.
OPENAI_TIMEOUT_SECONDS="120"                # A stalled request would otherwise hold a worker forever
OPENAI_MAX_WORKERS="30"                     # Requests in flight at once; lower it to stay inside a rate limit
USE_TOOL_CALLING="true"                     # Pick the next agent via tool calling instead of parsing an index
                                            # out of free text. Set to "false" for models without tool support.
USE_STRUCTURED_OUTPUTS="true"               # Let the API constrain RequestBuilder's reply to JSON instead of
                                            # relying on the prompt. Set to "false" for older models.
PARALLEL_AGENT_CALLS="true"                 # Run every agent the model asks for in one turn as parallel
                                            # siblings. Requires USE_TOOL_CALLING.

# Prompt size caps. Memories accumulate across a task tree and are re-sent on every
# agent call, so one large payload can overflow the model's context window. 0 = no limit.
MAX_MEMORY_ENTRIES="20"                     # Most recent memory entries kept in a prompt
MAX_MEMORY_ENTRY_CHARS="8000"               # A single memory entry is truncated past this
MAX_CHAT_HISTORY_MESSAGES="20"              # Most recent chat messages included in a prompt
EMIT_PROGRESS_EVENTS="true"                 # Tell the client which agents are working while a request
                                            # runs. Only the final answer arrives as a chat message.


# ================================
# Database Configuration
# ================================
DATABASE="sqlite"                           # sqlite, mongodb (default: sqlite, not recommended for production)

# >>> MongoDB Configuration (ignore if you are not using MongoDB) – note: MongoDB Atlas is recommended for production
MONGO_URI=""                                # URI to your MongoDB cluster
MONGO_DB_NAME=""                            # Name of the database to use

# >>> SQLite Configuration (ignore if you are not using SQLite)
SQLITE_DB_PATH="sqlite.db"                  # Path to the SQLite database file
# Note: If you change the database path, you should update .gitignore to ignore the new database path


# ================================
# Package Manager
# ================================
PACKAGE_MANAGER_URL="https://download-package-d6iaqsbjgq-uc.a.run.app"

# ================================
# City Search Agent (stella_agents/CustomAgents/CitySearchAgent.py)
# ================================
# Required. Read at call time, so a change takes effect without a restart.
WORKSPACE_URL=""                            # Databricks workspace URL, no trailing slash
DATABRICKS_TOKEN=""                         # Databricks personal access token

# Optional. Read at import time: changing these needs a server restart, not /agent/reload.
CITIES_LLM_MODEL="databricks-meta-llama-3-3-70b-instruct"   # Serving endpoint used for the summary
CITIES_ENDPOINT_NAME="wikivoyage_seach_endpoint"            # Vector Search endpoint
CITIES_INDEX_NAME="workspace.default.wikivoyage_index"      # Vector Search index
CITIES_COLUMNS="content,title,url"          # Comma-separated columns to retrieve
CITIES_NUM_RESULTS="3"                      # Passages to retrieve per search

# ================================
# Method Spec Agent (stella_agents/CustomAgents/MethodSpecAgent.py)
# ================================
SPEC_SOURCE_ROOT="."                        # Only files under here may be read. The path comes
                                            # from a chat message via an LLM, so this is what
                                            # stops it reading anything the process can.
SPEC_MAX_SOURCE_CHARS="40000"               # A file larger than this is refused rather than truncated
SPEC_MAX_METHODS_PER_FILE="12"              # One model call per method, so cap a large class
SPEC_OUTPUT_ROOT="spec_output"              # Where the full specification JSON is written. Memories
                                            # only carry a digest and this path, because they are
                                            # re-sent on every later agent call.
SPEC_MAX_METHODS_IN_DIGEST="8"              # Methods named in the digest; the file always has all
SPEC_MAX_QUESTIONS_PER_METHOD="3"           # Open questions kept per method, after near-duplicates
                                            # are collapsed. A reader handed twenty reads none
SPEC_SOURCE_SUFFIXES=".java"                # Comma-separated file types the repository scan reads
SPEC_MAX_FILES="50"                         # Files one scan will document before it stops
SPEC_CONCURRENCY="4"                        # Files documented at once; keep under OPENAI_MAX_WORKERS
SPEC_DOCUMENT_NAME="specification.md"       # The Markdown document written from the extracted specs
# What a finding is, is decided from the source line rather than by the model: line
# citations proved accurate, the kind did not. Point these at your own naming conventions.
SPEC_DB_PATTERN=""                          # Blank uses the default. Receivers counted as database access:
                                            # repo/repository/dao/mapper/entitymanager/jdbc/session)
SPEC_EXTERNAL_PATTERN=""                    # Blank uses the default. Receivers counted as leaving:
                                            # gateway/client/api/http/rest/feign/kafka/queue/mail/...)

# ================================
# Source upload (app/views/source.py)
# ================================
# How code reaches a server that is not running on the machine holding it: POST a zip to
# /workspace/<id>/source (the CLI's /upload). A workspace that has uploaded one reads it
# instead of SPEC_SOURCE_ROOT, and writes under SPEC_OUTPUT_ROOT/workspaces/<id>/.
SOURCE_UPLOAD_ROOT="uploads"                # Where an upload is unpacked, one directory per
                                            # workspace. MUST NOT be inside app/agents/ or the
                                            # stella_agents package -- an archive unpacked there
                                            # would be imported on the next /agent/reload.
                                            # Uploads are refused outright if it overlaps one.
SOURCE_UPLOAD_MAX_BYTES="52428800"          # Unpacked ceiling per workspace (50 MB). This is what
                                            # stops a zip bomb: deflate reaches about 1000:1.
SOURCE_UPLOAD_MAX_FILES="2000"              # Size alone does not bound the work; empty files weigh nothing
SOURCE_UPLOAD_MAX_REQUEST_BYTES="20971520"  # Largest request body Flask will accept at all (20 MB)
SPEC_DOWNLOAD_MAX_BYTES="52428800"          # Ceiling on what GET /workspace/<id>/spec (the CLI's
                                            # /download) will zip up and send back (50 MB)
